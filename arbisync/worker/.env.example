# =====================================================================
# ArbiSync – Einstellungen mit Geheimnissen
# ---------------------------------------------------------------------
# So benutzt du diese Datei:
#   1. Kopiere sie und nenne die Kopie ".env" (ohne ".example").
#   2. Trage deine Werte ein.
#   3. Die Datei ".env" wird NIE zu GitHub hochgeladen (steht in .gitignore).
# Alles andere (Gebühren, Regeln, Uhrzeiten, Limits) stellst du später im Dashboard ein.
# =====================================================================

# --- Zugang -----------------------------------------------------------

# Passwort, mit dem sich die Chrome-Extension beim Server anmeldet.
# Mindestens 32 Zeichen. Erzeugen: im Terminal  npm run schluessel
# (eine lange Zeichenkette erscheint – komplett hier einfügen).
API_KEY=

# Passwort für das Dashboard im Browser. Lang und einzigartig wählen.
DASHBOARD_PASSWORD=

# --- Betrieb ----------------------------------------------------------

# Woher kommen die Amazon-Preise?
#   extension = nur wenn du eine Amazon-Seite selbst öffnest (kostenlos, Start)
#   keepa     = Keepa-API im Hintergrund (ab 29 €/Monat, KEEPA_API_KEY nötig)
DATA_PROVIDER=extension

# Probelauf: true = alles wird berechnet, aber NICHTS wird an eBay gesendet.
# Erst auf false stellen, wenn alles getestet ist.
DRY_RUN=true

# sandbox = eBay-Testumgebung (kein echtes Geld), production = echtes eBay.de
EBAY_ENV=sandbox

# Preis gilt als veraltet nach so vielen Stunden (Schutzregel). Standard 12.
MAX_PRICE_AGE_HOURS=12

# --- eBay (Anleitung: docs/setup/06-ebay-developer.md) ----------------

# "App ID (Client ID)" aus developer.ebay.com → Application Keys
EBAY_CLIENT_ID=
# "Cert ID (Client Secret)" aus derselben Seite
EBAY_CLIENT_SECRET=
# "RuName" (eBay Redirect URL name) aus User Tokens → Get a Token from eBay via Your Application
EBAY_RU_NAME=
# Refresh-Token deines eBay-Verkäuferkontos (gilt 18 Monate, wird automatisch genutzt)
EBAY_REFRESH_TOKEN=

# --- Telegram (Anleitung: docs/setup/07-telegram.md) ------------------

# Token von @BotFather, Format 123456789:ABC...
TELEGRAM_BOT_TOKEN=
# Deine Chat-ID (Zahl), an die der Bot schreibt
TELEGRAM_CHAT_ID=

# --- Keepa (optional, später) ----------------------------------------

# API-Key von keepa.com → API. Leer lassen, solange DATA_PROVIDER=extension.
KEEPA_API_KEY=
# Tokens pro Minute laut deinem Keepa-Tarif (kleinster Tarif: 20)
KEEPA_TOKENS_PER_MIN=20
