{
  "name": "arbisync-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ArbiSync – Amazon.de → eBay.de Arbitrage (Cloudflare Worker)",
  "scripts": {
    "test": "vitest run",
    "beispiel": "tsx scripts/beispiele.ts",
    "schluessel": "node -e \"console.log(require('crypto').randomBytes(32).toString('hex'))\"",
    "typecheck": "tsc --noEmit",
    "db:lokal": "wrangler d1 migrations apply arbisync-db --local",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "4.13.16"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "22.18.12",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  }
}
