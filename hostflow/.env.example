# ----------------------------------------------------------------------------
# HostFlow — Umgebungsvariablen
# Kopiere diese Datei nach `.env.local` und trage echte Werte ein.
# `.env.local` wird NICHT eingecheckt.
# ----------------------------------------------------------------------------

# App-Basis-URL (für Redirects, Stripe-Return-URLs, E-Mail-Links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------------------------------------------------------
# Supabase  (Projekt in EU-Region anlegen → DSGVO!)
# Dashboard → Project Settings → API
# ----------------------------------------------------------------------------
# Projekt-URL, z. B. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Öffentlicher "anon"-Key (darf im Browser landen, RLS schützt die Daten)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-Role-Key — NUR serverseitig! Niemals an den Client geben.
# Wird für Admin-Aufgaben (Team-Einladung, Account-Löschung, Sync-Cron) genutzt.
SUPABASE_SERVICE_ROLE_KEY=

# Geheimnis für den Cron-Endpoint /api/cron/sync (Bearer-Token).
# Beliebige Zufallszeichenkette, z. B. via `openssl rand -hex 32`.
CRON_SECRET=

# ----------------------------------------------------------------------------
# Stripe  (ab Phase 8 — optional, bis dahin leer lassen)
# Test-Keys: https://dashboard.stripe.com/test/apikeys
# ----------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Signing-Secret des Webhook-Endpoints (stripe listen / Dashboard)
STRIPE_WEBHOOK_SECRET=
# Preis-IDs der Abo-Pläne (nach Objektanzahl) + einmalige Setup-Gebühr
STRIPE_PRICE_PLAN_S=        # bis 3 Objekte
STRIPE_PRICE_PLAN_M=        # bis 10 Objekte
STRIPE_PRICE_PLAN_L=        # unbegrenzt
STRIPE_PRICE_SETUP_FEE=     # einmalige Einrichtungsgebühr
